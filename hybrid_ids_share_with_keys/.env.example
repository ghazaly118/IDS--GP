# Hybrid IDS + IR environment variables

# Optional OpenRouter LLM report inside Streamlit IR tab
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional CICFlowMeter path for PCAP to CSV conversion
CICFLOWMETER_BIN=D:\Downloads\CICFlowMeter-master\CICFlowMeter-master\build\install\CICFlowMeter\bin\CICFlowMeter.bat

# IR demo mode note: this integrated project does not execute containment automatically.
IR_MODE=dry_run
