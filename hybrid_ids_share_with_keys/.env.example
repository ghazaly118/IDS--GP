# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. The Gemini model to use for the AI Investigator.
# Defaults to "gemini-2.5-flash" if not specified.
# GEMINI_MODEL="gemini-2.5-pro"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Real SSH Enforcement ─────────────────────────────────────────────────────
# Set to ssh_linux to enable real iptables enforcement on Linux VMs via SSH.
# ENFORCEMENT_MODE="ssh_linux"
# SSH_USER="your_ssh_username"
# SSH_PASSWORD="your_ssh_password"
# SSH_TIMEOUT=10

# IR_CONTROLLER_IP: Your Windows PC IP — the VM will keep this IP open even after isolation.
# IR_CONTROLLER_IP="192.168.67.1"

# Maps dashboard hostnames → real SSH IPs
# SSH_HOST_MAP={"kali-vm": "192.168.67.129"}
